# /etc/systemd/system/luiten-crm.service
# Luiten CRM (Flask + Waitress) achter nginx. Pas LCRM_PUBLIC_URL aan.
[Unit]
Description=Luiten CRM webapp
After=network-online.target
Wants=network-online.target

[Service]
User=lcrm
Group=lcrm
WorkingDirectory=/opt/luiten-crm
Environment=LCRM_PUBLIC_URL=https://crm.voorbeeld.nl
Environment=LCRM_DATA=/var/lib/luiten-crm
Environment=LCRM_PORT=8000
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Tijden van notities in lokale (beurs)tijd; een nieuwe VPS staat standaard op UTC
Environment=TZ=Europe/Amsterdam
ExecStart=/opt/luiten-crm/.venv/bin/python app.py
Restart=on-failure
RestartSec=3

# Data in /var/lib/luiten-crm, alleen leesbaar voor de gebruiker lcrm
StateDirectory=luiten-crm
StateDirectoryMode=0700
UMask=0077

# Afscherming
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
